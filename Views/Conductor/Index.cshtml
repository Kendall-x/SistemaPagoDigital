@{
    ViewData["Title"] = "Panel del Conductor";
}

<h2>Panel del Conductor</h2>

<p>Bienvenido al módulo de conductores.</p>

<div class="mt-4">
    <a asp-controller="Conductor"
       asp-action="PagosRecibidos"
       class="btn btn-primary">
        Consultar pagos recibidos
    </a>
</div>

<div class="mt-3">
    <a asp-controller="Reporte"
       asp-action="CobrosPorEstado"
       class="btn btn-primary">
        Consultar cobros por estado
    </a>
</div>

<div class="mt-3">
    <a asp-controller="Reporte"
       asp-action="CobrosPorFecha"
       class="btn btn-primary">
        Consultar cobros por fecha
    </a>
</div>

<div class="mt-3">
    <a asp-controller="Reporte"
       asp-action="Ingresos"
       class="btn btn-success">
        Consultar ingresos
    </a>
</div>

<a asp-controller="Reporte"
   asp-action="CantidadCobrosPorEstado"
   class="btn btn-primary">
    Cantidad de cobros por estado
</a>