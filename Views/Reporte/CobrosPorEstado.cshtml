@model List<SistemaPagoDigital.Models.Cobro>

@{
    ViewData["Title"] = "Cobros por Estado";
}

<h2>Cobros por estado</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="CobrosPorEstado" method="get" class="mb-3">
    <label class="form-label">Seleccionar estado:</label>

    <select name="estado" class="form-select">
        <option value="Pendiente">Pendiente</option>
        <option value="Pagado">Pagado</option>
        <option value="Validado">Validado</option>
        <option value="Expirado">Expirado</option>
        <option value="Cancelado">Cancelado</option>
    </select>

    <button type="submit" class="btn btn-primary mt-2">
        Consultar
    </button>
</form>

@if (Model.Count == 0)
{
    <p>No hay cobros registrados con ese estado.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Descripción</th>
                <th>Monto</th>
                <th>Código</th>
                <th>Fecha de creación</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cobro in Model)
            {
                <tr>
                    <td>@cobro.Descripcion</td>
                    <td>@cobro.Monto.ToString("C")</td>
                    <td>@cobro.Codigo</td>
                    <td>@cobro.FechaCreacion</td>
                    <td>@cobro.Estado</td>
                    <td>
                        @if (cobro.Estado == "Pendiente")
                        {
                            <form asp-controller="Cobro"
                                  asp-action="Cancelar"
                                  method="post">

                                <input type="hidden"
                                       name="cobroId"
                                       value="@cobro.Id" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Cancelar
                                </button>
                            </form>
                        }
                        else
                        {
                            <span>No disponible</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}