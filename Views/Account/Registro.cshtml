@model SistemaPagoDigital.ViewModels.RegistroViewModel

@{
    ViewData["Title"] = "Registro de usuario";
}

<h2>Crear una cuenta</h2>

<form asp-controller="Account" asp-action="Registro" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Agregar los campos -->
    <div>
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

        <div>
        <label asp-for="Apellidos"></label>
        <input asp-for="Apellidos" class="form-control" />
        <span asp-validation-for="Apellidos" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Identificacion">Identificación</label>
        <input asp-for="Identificacion" class="form-control" />
        <span asp-validation-for="Identificacion" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Correo"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>

    <!-- Agregar la contraseña -->
    <div>
        <label asp-for="Contrasena">Contraseña</label>
        <input asp-for="Contrasena" type="password" class="form-control" />
        <span asp-validation-for="Contrasena" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ConfirmarContrasena">Confirmar Contraseña</label>
        <input asp-for="ConfirmarContrasena" type="password" class="form-control" />
        <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
    </div>

    <!-- Seleccionar el rol de Usuario -->
    <div>
        <label asp-for="Rol">Tipo de usuario</label>

        <select asp-for="Rol" class="form-control">
            <option value="">Seleccione un rol</option>
            <option value="Cliente">Cliente</option>
            <option value="Conductor">Conductor</option>
        </select>

        <span asp-validation-for="Rol" class="text-danger"></span>
    </div>

    <button type="submit">Registrarse</button>

</form>
